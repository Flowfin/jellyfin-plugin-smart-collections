<Project>
    <PropertyGroup>
        <!-- A committed lockfile per project. Without one a restore is free to resolve a
             transitive package to whatever the feed offers that day, so two builds of the
             same commit can carry different code and neither says so. With one, that
             resolution is a file in the tree and a change to it is a diff somebody reads.
    
             Locked mode is not turned on here but passed as a flag on the CI routes that
             must not move the graph, because turning it on for every local build would
             refuse the ordinary act of adding a package before the lockfile has been
             written.
    
             publish.yaml has restored in locked mode since it was written and fails with
             an explicit error when the lockfile is absent, which it was: the release route
             would have failed on first use, and it has never run.
    
             Note for whoever edits this comment: an XML comment may not contain two
             hyphens in a row, so the flag is named in prose rather than written out. A
             draft that spelled it left this file malformed, MSBuild lost everything after
             the comment, and the restore failed on a property defined further down. -->
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    </PropertyGroup>

    <PropertyGroup>
        <Version>0.0.0.0</Version>
        <AssemblyVersion>0.0.0.0</AssemblyVersion>
        <FileVersion>0.0.0.0</FileVersion>
    </PropertyGroup>
</Project>
