<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The same pair the plugin builds for. A test project on one framework cannot be built
         alongside a plugin being built for the other, so a build of the 12.0 line would stop at
         this project rather than at anything it is testing. -->
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Jellyfin.Plugin.SmartCollections.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <!-- Asked for so the compiler parses the documentation comments in this project, which is
         what refuses one whose XML does not close. Both shipped projects ask for it and a
         malformed comment is a red build there; this project raised warnings to errors and asked
         for no documentation file, so the same mistake was silent in the one project holding most
         of this repository's explanatory prose. Two of them had landed and stayed.

         CS1591 is the warning for a public member carrying no documentation comment, and it
         arrives with the documentation file rather than being asked for. It is suppressed because
         requiring a comment on every test method is a rule about how tests are written and not
         about malformed XML, and imposing one here would be deciding that rule in a property
         group. What the suppression leaves unreported is the state this project is already in. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The coverage collector runs inside `dotnet test`, so measuring costs a flag on
         the command the suite already runs rather than a second tool, a second runtime
         or a service. Collecting "XPlat Code Coverage" from `dotnet test` writes a
         Cobertura report, and .github/scripts/coverage-floor.js holds each assembly at
         the score recorded in coverage-floors.json, which carries the command. -->
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The plugin project excludes the Jellyfin runtime assets, because the server
       supplies them at load time. A test process has no server, so the same two
       packages are referenced here without that exclusion, which is what puts
       MediaBrowser.Common and MediaBrowser.Model next to the test assembly. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Jellyfin.Controller" Version="10.11.0" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0-rc4" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0-rc4" />
  </ItemGroup>

  <!-- Both projects, named rather than reached through the host. The engine arrives transitively
       either way, but a test that asserts something about the engine assembly should fail to
       compile if that reference goes away rather than keep resolving through whatever the host
       happens to reference that day. -->
  <ItemGroup>
    <ProjectReference Include="..\Jellyfin.Plugin.SmartCollections\Jellyfin.Plugin.SmartCollections.csproj" />
    <ProjectReference Include="..\Jellyfin.Plugin.SmartCollections.Engine\Jellyfin.Plugin.SmartCollections.Engine.csproj" />
  </ItemGroup>

</Project>
