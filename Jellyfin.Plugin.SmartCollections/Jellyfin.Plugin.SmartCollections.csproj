<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- One codebase, two packages. Jellyfin 10.11 hosts .NET 9 and Jellyfin 12.0 hosts
         .NET 10, so a package built for one line does not load on the other. -->
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Jellyfin.Plugin.SmartCollections</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <CodeAnalysisRuleSet>../jellyfin.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <!-- The server SDK version each line's package is built against. These are properties
       rather than literals on the references so a build can be pointed at a different one
       from the command line, which is what the ABI floor check does (#11). A build that
       overrides nothing gets exactly the versions that were here before.

       There is one property per line rather than one shared property, because restore is a
       cross-targeting operation: it resolves every target framework whatever -f says, so a
       single overridden property would push one line's version at the other line as well.
       Measured rather than supposed: with one property, -f net10.0 -p:...=12.0.0-rc4 fails
       restore with NU1202 naming net9.0. -->
  <PropertyGroup>
    <JellyfinSdkVersionNet9 Condition="'$(JellyfinSdkVersionNet9)' == ''">10.11.11</JellyfinSdkVersionNet9>
    <JellyfinSdkVersionNet10 Condition="'$(JellyfinSdkVersionNet10)' == ''">12.0.0-rc4</JellyfinSdkVersionNet10>
  </PropertyGroup>

  <!-- The server supplies these at load time, so their runtime assets stay out of the package
       on both lines. The version follows the target framework: each server line ships the SDK
       built against the runtime that line hosts. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinSdkVersionNet9)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinSdkVersionNet9)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinSdkVersionNet10)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinSdkVersionNet10)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SerilogAnalyzer" Version="0.15.0" PrivateAssets="All" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
